# UniMate AI University Assistant - Configuration
# Add your Google Gemini API key below to enable live cloud LLM responses.
# If left blank, UniMate automatically operates using its built-in Local RAG Semantic Retrieval Engine.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=5173
